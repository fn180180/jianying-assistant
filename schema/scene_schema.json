{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/jianying-assistant/scene.schema.json",
  "title": "JianyingAssistantSceneDocument",
  "description": "Coze 工作流輸出的 Scene JSON，供本地剪映小助手轉成草稿",
  "type": "object",
  "required": ["title", "scenes"],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "草稿名稱"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 1, "default": 1080 },
        "height": { "type": "integer", "minimum": 1, "default": 1920 },
        "fps": { "type": "integer", "minimum": 1, "maximum": 120, "default": 30 }
      }
    },
    "bgm": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "description": "本地音訊路徑" },
        "volume": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 },
        "fade_in": { "type": "string", "default": "1s" },
        "fade_out": { "type": "string", "default": "1s" },
        "duration": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "text_style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": { "type": "number", "exclusiveMinimum": 0, "default": 5.0 },
        "color_r": { "type": "number", "minimum": 0, "maximum": 1, "default": 1.0 },
        "color_g": { "type": "number", "minimum": 0, "maximum": 1, "default": 1.0 },
        "color_b": { "type": "number", "minimum": 0, "maximum": 1, "default": 1.0 },
        "transform_y": { "type": "number", "default": -0.8 },
        "auto_wrapping": { "type": "boolean", "default": true },
        "max_line_width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.8 }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["video", "image"] },
          "path": { "type": "string" },
          "duration": { "type": "number", "exclusiveMinimum": 0 },
          "source_start": { "type": "number", "minimum": 0, "default": 0 },
          "speed": { "type": "number", "exclusiveMinimum": 0, "default": 1.0 },
          "text": { "type": ["string", "null"] },
          "volume": { "type": "number", "minimum": 0, "maximum": 1, "default": 1.0 }
        }
      }
    },
    "draft_folder": {
      "type": "string",
      "description": "剪映草稿根目錄"
    },
    "allow_replace": {
      "type": "boolean",
      "default": true
    }
  }
}
